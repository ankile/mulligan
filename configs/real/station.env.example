# ~/.config/droid/station.env -- per-machine DROID station identity (keys only).
# Read by droid/misc/station_env.py in the pinned DROID fork (see docs/hardware/droid_fork.md).
# One KEY=VALUE per line, optional quotes around the value, '#' only at the start of a line
# (there are no inline comments). Unknown keys are an error. Explicit DROID_* environment
# variables override the file; DROID_STATION_ENV_FILE=<path> reads another file instead
# (for example a test file). A file holding a secret must be chmod 600.
# Never commit a filled-in copy.

# Workstation and NUC. DROID_ROBOT_TYPE is panda or fr3.
DROID_NUC_IP=
DROID_ROBOT_IP=
DROID_LAPTOP_IP=
DROID_ROBOT_TYPE=
DROID_ROBOT_SERIAL_NUMBER=

# Upstream DROID camera ids. Mulligan does not use them: it maps cameras by role in
# configs/real/station.example.yaml.
DROID_HAND_CAMERA_ID=
DROID_VARIED_CAMERA_1_ID=
DROID_VARIED_CAMERA_2_ID=

# NUC only. Must NOT be set on the workstation (mulligan.real.robot.station refuses to run).
# Leave DROID_SUDO_PASSWORD empty when the NUC has the NOPASSWD sudoers rule of docs/station.md.
# DROID_UBUNTU_PRO_TOKEN is only used when setting up the NUC's real-time kernel.
DROID_SUDO_PASSWORD=
DROID_UBUNTU_PRO_TOKEN=
