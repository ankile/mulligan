{
  "name": "policy-arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "flatted": "3.4.4",
    "picomatch": "4.0.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json && tsc -p convex/tsconfig.json && vite build && bun scripts/leak_check.ts --app dist",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p convex/tsconfig.json && tsc -p tsconfig.release.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "bun test",
    "check:api": "bun scripts/capture_api.ts",
    "check:closure": "bun scripts/release_closure.ts",
    "build:release": "tsc -p tsconfig.release.json && tsc -p tsconfig.node.json && vite build --config vite.release.config.ts",
    "package:release": "bun scripts/package_release.ts",
    "verify:data": "bun scripts/verify_release_data.ts data/release.json data/ui.json",
    "leak-check": "bun scripts/leak_check.ts dist-release"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@huggingface/hub": "^2.16.1",
    "apache-arrow": "^21.2.0",
    "convex": "^1.45.0",
    "hyparquet": "^1.29.2",
    "parquet-wasm": "^0.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@happy-dom/global-registrator": "^20.12.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "convex-test": "^0.0.56",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "8.2.2"
  }
}
