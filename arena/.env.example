# Policy Arena configuration. Copy to .env.local (git-ignored) for local work; `npx convex dev`
# writes the first two lines itself. Never commit real values.

# --- Frontend build (Vite reads VITE_* at build time; set the same values in the Vercel or
# --- Cloudflare Pages project settings) ---
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
# Only for a self-hosted or local backend, whose HTTP-action origin is not <name>.convex.site:
# VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# --- Backend (Convex deployment environment; set with `npx convex env set NAME value`, not here) ---
# SITE_URL                        public URL of your frontend, e.g. https://arena.example.org
# AUTH_HUGGINGFACE_ID             Hugging Face OAuth app client id
# AUTH_HUGGINGFACE_SECRET         Hugging Face OAuth app client secret
# JWT_PRIVATE_KEY, JWKS           signing keys, generated by `npx @convex-dev/auth`
# ARENA_EDITOR_SUBS               comma-separated Hugging Face account ids (OIDC sub) allowed to edit
# ARENA_SERVICE_TOKEN             random secret bridging the machine HTTP API to mutations
# POLICY_ARENA_MACHINE_KEYS_JSON  {"<key-id>": {"sha256": "<hex digest of key>", "scopes": ["ingest"]}}
# HF_TOKEN                        Hugging Face token: read for dataset stats, write for review apply

# --- Robot side and scripts (Python client, scripts/rebuild_dataset_stats.ts) ---
# POLICY_ARENA_URL=https://your-deployment-name.convex.cloud
# POLICY_ARENA_API_URL=https://your-deployment-name.convex.site/api/v1   (default for .convex.cloud)
# POLICY_ARENA_API_KEY=<key-id>.<secret>   (or a file at ~/.config/policy-arena/api_key)
